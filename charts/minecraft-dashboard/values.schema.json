{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "definitions": {
    "cidr": {"type": "string", "pattern": "^[0-9a-fA-F:.]+/[0-9]{1,3}$"},
    "tier": {
      "type": "object",
      "properties": {
        "nfs": {
          "type": "object",
          "properties": {
            "server": {"type": "string"},
            "path": {"type": "string"}
          },
          "additionalProperties": false
        },
        "hostPath": {"type": "string"},
        "existingClaim": {"type": "string"},
        "size": {"type": "string"},
        "mountOptions": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "image": {
      "type": "object",
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string"},
        "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
      },
      "required": ["repository"]
    },
    "storage": {
      "type": "object",
      "properties": {
        "archive": {"$ref": "#/definitions/tier"},
        "store": {"$ref": "#/definitions/tier"}
      },
      "required": ["archive", "store"]
    },
    "worlds": {
      "type": "object",
      "properties": {
        "portMin": {"type": "integer", "minimum": 30000, "maximum": 32767},
        "portMax": {"type": "integer", "minimum": 30000, "maximum": 32767},
        "rconPortMin": {"type": "integer", "minimum": 30000, "maximum": 32767},
        "rconPortMax": {"type": "integer", "minimum": 30000, "maximum": 32767},
        "rconHost": {"type": "string"},
        "publicHost": {"type": "string"},
        "node": {"type": "string"},
        "storageClass": {"type": "string"},
        "size": {"type": "string"},
        "defaultMemory": {"type": "string"},
        "snapshotKeep": {"type": "integer", "minimum": 1},
        "uid": {"type": "integer"},
        "gid": {"type": "integer"}
      },
      "additionalProperties": false
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "rconAllowedCidrs": {
          "type": ["array", "null"],
          "items": {
            "oneOf": [
              {"$ref": "#/definitions/cidr"},
              {
                "type": "object",
                "properties": {
                  "cidr": {"$ref": "#/definitions/cidr"},
                  "except": {"type": "array", "items": {"$ref": "#/definitions/cidr"}}
                },
                "required": ["cidr"],
                "additionalProperties": false
              }
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "service": {
      "type": "object",
      "properties": {
        "type": {"type": "string"},
        "port": {"type": "integer"}
      }
    },
    "extraEnv": {"type": "array"}
  }
}
